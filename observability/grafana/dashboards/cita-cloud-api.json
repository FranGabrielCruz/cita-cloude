{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "stat", "title": "Estado de la API", "id": 1,
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "targets": [{"expr": "up{job=\"cita-cloud-api\"}", "legendFormat": "API", "refId": "A"}],
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "CAÍDA", "color": "red"}, "1": {"text": "DISPONIBLE", "color": "green"}}}], "thresholds": {"mode": "absolute", "steps": [{"color": "red"}, {"color": "green", "value": 1}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}}
    },
    {
      "type": "stat", "title": "Solicitudes por minuto", "id": 2,
      "gridPos": {"h": 4, "w": 5, "x": 4, "y": 0},
      "targets": [{"expr": "sum(rate(http_server_requests_seconds_count{job=\"cita-cloud-api\"}[5m])) * 60", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqpm"}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}}
    },
    {
      "type": "stat", "title": "Tasa de errores 5xx", "id": 3,
      "gridPos": {"h": 4, "w": 5, "x": 9, "y": 0},
      "targets": [{"expr": "100 * sum(rate(http_server_requests_seconds_count{job=\"cita-cloud-api\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"cita-cloud-api\"}[5m])), 0.001)", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent", "thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "orange", "value": 2}, {"color": "red", "value": 5}]}}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}}
    },
    {
      "type": "stat", "title": "Errores 5xx por minuto", "id": 4,
      "gridPos": {"h": 4, "w": 5, "x": 14, "y": 0},
      "targets": [{"expr": "sum(rate(http_server_requests_seconds_count{job=\"cita-cloud-api\",status=~\"5..\"}[5m])) * 60", "refId": "A"}],
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "red", "value": 1}]}}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}}
    },
    {
      "type": "stat", "title": "Cola pendiente", "id": 5,
      "gridPos": {"h": 4, "w": 5, "x": 19, "y": 0},
      "targets": [{"expr": "notification_queue_depth{job=\"cita-cloud-api\",status=\"pendiente\"}", "refId": "A"}],
      "fieldConfig": {"defaults": {"decimals": 0}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}}
    },
    {
      "type": "timeseries", "title": "Latencia HTTP p50 / p95 / p99", "id": 6,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"cita-cloud-api\"}[5m])))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"cita-cloud-api\"}[5m])))", "legendFormat": "p95", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"cita-cloud-api\"}[5m])))", "legendFormat": "p99", "refId": "C"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "type": "timeseries", "title": "Solicitudes por estado", "id": 7,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "targets": [{"expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"cita-cloud-api\"}[5m])) * 60", "legendFormat": "{{status}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqpm"}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "type": "table", "title": "Endpoints más lentos (p95)", "id": 8,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "targets": [{"expr": "topk(10, histogram_quantile(0.95, sum by (le, uri, method) (rate(http_server_requests_seconds_bucket{job=\"cita-cloud-api\"}[5m]))))", "format": "table", "instant": true, "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "options": {"showHeader": true}
    },
    {
      "type": "timeseries", "title": "JVM, CPU y conexiones", "id": 9,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "targets": [
        {"expr": "process_cpu_usage{job=\"cita-cloud-api\"} * 100", "legendFormat": "CPU %", "refId": "A"},
        {"expr": "100 * sum(jvm_memory_used_bytes{job=\"cita-cloud-api\",area=\"heap\"}) / sum(jvm_memory_max_bytes{job=\"cita-cloud-api\",area=\"heap\"})", "legendFormat": "Heap %", "refId": "B"},
        {"expr": "100 * hikaricp_connections_active{job=\"cita-cloud-api\"} / clamp_min(hikaricp_connections_max{job=\"cita-cloud-api\"}, 1)", "legendFormat": "Pool DB %", "refId": "C"}
      ],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "type": "timeseries", "title": "Notificaciones y PDF", "id": 10,
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 20},
      "targets": [
        {"expr": "sum(rate(email_sent_total{job=\"cita-cloud-api\"}[5m])) * 60", "legendFormat": "Email enviados/min", "refId": "A"},
        {"expr": "sum(rate(email_failed_total{job=\"cita-cloud-api\"}[5m])) * 60", "legendFormat": "Email fallidos/min", "refId": "B"},
        {"expr": "sum(rate(whatsapp_sent_total{job=\"cita-cloud-api\"}[5m])) * 60", "legendFormat": "WhatsApp enviados/min", "refId": "C"},
        {"expr": "sum(rate(whatsapp_failed_total{job=\"cita-cloud-api\"}[5m])) * 60", "legendFormat": "WhatsApp fallidos/min", "refId": "D"},
        {"expr": "sum(rate(pdf_generated_total{job=\"cita-cloud-api\"}[5m])) * 60", "legendFormat": "PDF generados/min", "refId": "E"},
        {"expr": "sum(rate(pdf_failed_total{job=\"cita-cloud-api\"}[5m])) * 60", "legendFormat": "PDF fallidos/min", "refId": "F"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["cita-cloud", "api", "observability"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "CITA CLOUD — API",
  "uid": "cita-cloud-api",
  "version": 1
}
