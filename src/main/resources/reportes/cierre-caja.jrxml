<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="cierre_caja" whenNoDataType="AllSectionsNoDetail" pageWidth="595" pageHeight="842" columnWidth="511" leftMargin="42" rightMargin="42" topMargin="28" bottomMargin="28">
<parameter name="CLINICA" class="java.lang.String"/><parameter name="RNC" class="java.lang.String"/><parameter name="SUCURSAL" class="java.lang.String"/><parameter name="DIRECCION" class="java.lang.String"/><parameter name="CAJA" class="java.lang.String"/><parameter name="USUARIO" class="java.lang.String"/><parameter name="NUMERO" class="java.lang.String"/><parameter name="APERTURA" class="java.lang.String"/><parameter name="CIERRE" class="java.lang.String"/><parameter name="FONDO" class="java.math.BigDecimal"/><parameter name="INGRESOS" class="java.math.BigDecimal"/><parameter name="EGRESOS" class="java.math.BigDecimal"/><parameter name="ESPERADO" class="java.math.BigDecimal"/><parameter name="CONTADO" class="java.math.BigDecimal"/><parameter name="DIFERENCIA" class="java.math.BigDecimal"/><parameter name="MOTIVO" class="java.lang.String"/><parameter name="DESGLOSE" class="java.lang.String"/>
<field name="hora" class="java.lang.String"/><field name="tipo" class="java.lang.String"/><field name="referencia" class="java.lang.String"/><field name="metodo" class="java.lang.String"/><field name="entrada" class="java.math.BigDecimal"/><field name="salida" class="java.math.BigDecimal"/>
<title><band height="160"><rectangle><reportElement x="0" y="0" width="511" height="76" mode="Opaque" backcolor="#103B72"/></rectangle><textField><reportElement x="18" y="14" width="310" height="24" forecolor="#FFFFFF"/><textElement><font size="17" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{CLINICA}]]></textFieldExpression></textField><textField><reportElement x="18" y="43" width="310" height="15" forecolor="#D7E5F8"/><textFieldExpression><![CDATA[$P{SUCURSAL}]]></textFieldExpression></textField><staticText><reportElement x="345" y="15" width="148" height="18" forecolor="#FFFFFF"/><textElement textAlignment="Right"><font size="12" isBold="true"/></textElement><text><![CDATA[CIERRE DE CAJA]]></text></staticText><textField><reportElement x="345" y="40" width="148" height="16" forecolor="#D7E5F8"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$P{RNC}.isBlank()?"":"RNC: "+$P{RNC}]]></textFieldExpression></textField><textField><reportElement x="0" y="94" width="250" height="20" forecolor="#103B72"/><textElement><font size="13" isBold="true"/></textElement><textFieldExpression><![CDATA["No. "+$P{NUMERO}]]></textFieldExpression></textField><staticText><reportElement x="390" y="94" width="121" height="20" forecolor="#15803D"/><textElement textAlignment="Right"><font size="11" isBold="true"/></textElement><text><![CDATA[CERRADA]]></text></staticText><textField><reportElement x="0" y="120" width="511" height="16"/><textFieldExpression><![CDATA[$P{CIERRE}.startsWith("20")?java.time.LocalDateTime.parse($P{CIERRE}).format(java.time.format.DateTimeFormatter.ofPattern("dd/MM/yyyy · h:mm a",java.util.Locale.US)):$P{CIERRE}]]></textFieldExpression></textField></band></title>
<columnHeader><band height="38"><staticText><reportElement x="0" y="0" width="511" height="15" forecolor="#103B72"/><textElement><font size="11" isBold="true"/></textElement><text><![CDATA[MOVIMIENTOS DEL TURNO]]></text></staticText><rectangle><reportElement x="0" y="18" width="511" height="20" mode="Opaque" backcolor="#E7F0FB"/></rectangle><staticText><reportElement x="10" y="22" width="80" height="13" forecolor="#103B72"/><text><![CDATA[HORA]]></text></staticText><staticText><reportElement x="95" y="22" width="110" height="13" forecolor="#103B72"/><text><![CDATA[TIPO]]></text></staticText><staticText><reportElement x="210" y="22" width="105" height="13" forecolor="#103B72"/><text><![CDATA[REFERENCIA]]></text></staticText><staticText><reportElement x="320" y="22" width="95" height="13" forecolor="#103B72"/><text><![CDATA[MÉTODO]]></text></staticText><staticText><reportElement x="420" y="22" width="81" height="13" forecolor="#103B72"/><textElement textAlignment="Right"/><text><![CDATA[MONTO]]></text></staticText></band></columnHeader>
<detail><band height="22"><textField><reportElement x="10" y="4" width="80" height="14"/><textFieldExpression><![CDATA[$F{hora}.startsWith("20")?java.time.LocalDateTime.parse($F{hora}).format(java.time.format.DateTimeFormatter.ofPattern("h:mm:ss a",java.util.Locale.US)):$F{hora}]]></textFieldExpression></textField><textField><reportElement x="95" y="4" width="110" height="14"/><textFieldExpression><![CDATA[$F{tipo}]]></textFieldExpression></textField><textField><reportElement x="210" y="4" width="105" height="14"/><textFieldExpression><![CDATA[$F{referencia}]]></textFieldExpression></textField><textField><reportElement x="320" y="4" width="95" height="14"/><textFieldExpression><![CDATA[$F{metodo}]]></textFieldExpression></textField><textField><reportElement x="420" y="4" width="81" height="14" forecolor="#103B72"/><textElement textAlignment="Right"><font isBold="true"/></textElement><textFieldExpression><![CDATA["RD$ "+($F{entrada}.compareTo(java.math.BigDecimal.ZERO)>0?$F{entrada}:$F{salida}.negate()).setScale(2)]]></textFieldExpression></textField></band></detail>
<pageFooter><band height="24"><line><reportElement x="0" y="0" width="511" height="1" forecolor="#CBD5E1"/></line><textField evaluationTime="Report"><reportElement x="350" y="7" width="161" height="14" forecolor="#64748B"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA["Página "+$V{PAGE_NUMBER}+" de "+$V{PAGE_NUMBER}]]></textFieldExpression></textField></band></pageFooter>
<summary><band height="270"><rectangle><reportElement x="0" y="12" width="511" height="112" mode="Opaque" backcolor="#F8FAFC"/></rectangle><staticText><reportElement x="16" y="22" width="250" height="15" forecolor="#103B72"/><textElement><font size="11" isBold="true"/></textElement><text><![CDATA[RESUMEN FINANCIERO]]></text></staticText><textField><reportElement x="16" y="47" width="240" height="14"/><textFieldExpression><![CDATA["Fondo inicial: RD$ "+$P{FONDO}.setScale(2)]]></textFieldExpression></textField><textField><reportElement x="16" y="68" width="240" height="14"/><textFieldExpression><![CDATA["Ingresos: RD$ "+$P{INGRESOS}.setScale(2)]]></textFieldExpression></textField><textField><reportElement x="16" y="89" width="240" height="14"/><textFieldExpression><![CDATA["Egresos: RD$ "+$P{EGRESOS}.setScale(2)]]></textFieldExpression></textField><textField><reportElement x="270" y="47" width="225" height="14" forecolor="#103B72"/><textElement textAlignment="Right"><font isBold="true"/></textElement><textFieldExpression><![CDATA["Efectivo esperado: RD$ "+$P{ESPERADO}.setScale(2)]]></textFieldExpression></textField><textField><reportElement x="270" y="68" width="225" height="14" forecolor="#103B72"/><textElement textAlignment="Right"><font isBold="true"/></textElement><textFieldExpression><![CDATA["Efectivo contado: RD$ "+$P{CONTADO}.setScale(2)]]></textFieldExpression></textField><textField><reportElement x="270" y="89" width="225" height="14" forecolor="#15803D"/><textElement textAlignment="Right"><font isBold="true"/></textElement><textFieldExpression><![CDATA["Diferencia: RD$ "+$P{DIFERENCIA}.setScale(2)]]></textFieldExpression></textField><textField><reportElement x="0" y="145" width="511" height="20" forecolor="#15803D"/><textElement textAlignment="Center"><font size="13" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{DIFERENCIA}.signum()==0?"RESULTADO: CUADRADO":($P{DIFERENCIA}.signum()>0?"RESULTADO: SOBRANTE":"RESULTADO: FALTANTE")]]></textFieldExpression></textField><staticText><reportElement x="0" y="185" width="511" height="15" forecolor="#103B72"/><textElement><font size="10" isBold="true"/></textElement><text><![CDATA[OBSERVACIONES DEL CIERRE]]></text></staticText><textField><reportElement x="0" y="207" width="511" height="30"/><textFieldExpression><![CDATA[$P{MOTIVO}.isBlank()?"Sin observaciones.":"Justificación: "+$P{MOTIVO}]]></textFieldExpression></textField></band></summary>
</jasperReport>
